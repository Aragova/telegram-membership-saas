# Explicit opt-in isolated reader. Never built/started by the ordinary bots.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[channel-finance]"
USER 25073:25073
CMD ["uvicorn", "telegram_membership_saas.channel_finance_agent:app", "--host", "0.0.0.0", "--port", "8033", "--no-proxy-headers"]
