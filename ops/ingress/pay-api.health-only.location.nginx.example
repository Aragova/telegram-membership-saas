# Stage 4C, opt-in only. LOCATION BLOCK, not a complete vhost.
# After independent API deployment is healthy on 127.0.0.1:18080,
# replace ONLY the existing exact /health location in the 443 ssl
# server_name pay-api.usevimi.ru block. Preserve location / returning 404.
# Do not paste into HTTP/ACME server. Never deploy automatically.
location = /health {
    limit_except GET {
        deny all;
    }
    proxy_pass http://127.0.0.1:18080/health;
    proxy_http_version 1.1;
    proxy_set_header Host pay-api.usevimi.ru;
    proxy_set_header Connection "";
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;
    proxy_next_upstream off;
    proxy_buffering off;
    proxy_redirect off;
}
