# Example only. DO NOT put real values or backup private keys in Git.
# Install as /etc/vimi-pay/backup.env, root:root, chmod 0600.
# Create an isolated bucket before configuring this job.
# Cloud Run IAM-protected session broker service URL (no /session suffix).
VIMI_BACKUP_SESSION_SERVICE_URL=https://your-private-broker-xxxxx-ew.a.run.app
# Public recipient only. Store the corresponding age PRIVATE key offline.
VIMI_BACKUP_AGE_RECIPIENT=age1replace-with-valid-public-recipient
VIMI_BACKUP_POSTGRES_CONTAINER=telegram-membership-saas-staging-postgres-1
