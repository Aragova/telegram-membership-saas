TMS_ENVIRONMENT=development
TMS_LOG_LEVEL=INFO
# Runtime connection: must be a non-superuser role without BYPASSRLS.
TMS_DATABASE_URL=postgresql+asyncpg://membership_runtime:membership_runtime@postgres:5432/membership
# Migration/owner connection: used by Alembic only. Keep separate from runtime in staging/production.
TMS_MIGRATION_DATABASE_URL=postgresql+asyncpg://membership:membership@postgres:5432/membership
TMS_DEFAULT_PROJECT_TIMEZONE=Europe/Moscow
# Never commit a real token. Set it only in runtime secrets/environment.
# Separate Fernet key for encrypted customer bot tokens (generate on the VM).
# Never commit the actual key; losing it makes registered tokens unrecoverable.
TMS_BOT_TOKEN_ENCRYPTION_KEY=
TMS_TELEGRAM_BOT_TOKEN=
# One bot runtime is bound to one project in the current MVP.
TMS_TELEGRAM_PROJECT_ID=
# Customer runtime uses the registered numeric BotInstance Telegram ID.
TMS_CUSTOMER_TELEGRAM_BOT_ID=
# Must switch to false only together with a live customer-bot access worker.
TMS_TELEGRAM_CENTRAL_ACCESS_ENABLED=true
TMS_TELEGRAM_WORKER_POLL_SECONDS=1
