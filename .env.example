TMS_ENVIRONMENT=development
TMS_LOG_LEVEL=INFO
# Runtime connection: must be a non-superuser role without BYPASSRLS.
TMS_DATABASE_URL=postgresql+asyncpg://membership_runtime:membership_runtime@postgres:5432/membership
# Migration/owner connection: used by Alembic only. Keep separate from runtime in staging/production.
TMS_MIGRATION_DATABASE_URL=postgresql+asyncpg://membership:membership@postgres:5432/membership
TMS_DEFAULT_PROJECT_TIMEZONE=Europe/Moscow
# Numeric Telegram user ID of the ViMi Pay Platform Owner (central bot only).
# Configure privately on the server; never commit a real identifier.
TMS_PLATFORM_OWNER_TELEGRAM_ID=
TMS_PLATFORM_TIMEZONE=Europe/Moscow
# Optional: owner-only GCS freshness monitor (needs VM bucket objectViewer IAM).
TMS_PLATFORM_BACKUP_GCS_BUCKET=
# Never commit a real token. Set it only in runtime secrets/environment.
# Separate Fernet key for encrypted customer bot tokens (generate on the VM).
# Never commit the actual key; losing it makes registered tokens unrecoverable.
TMS_BOT_TOKEN_ENCRYPTION_KEY=
TMS_TELEGRAM_BOT_TOKEN=
# One bot runtime is bound to one project in the current MVP.
TMS_TELEGRAM_PROJECT_ID=
# Customer runtime uses the registered numeric BotInstance Telegram ID.
TMS_CUSTOMER_TELEGRAM_BOT_ID=
# Must switch to false only together with a live customer-bot access worker.
TMS_TELEGRAM_CENTRAL_ACCESS_ENABLED=true
TMS_TELEGRAM_WORKER_POLL_SECONDS=1

# CENTRAL ViMi Pay SaaS invoice rails (not merchant/buyer bot tokens).
# Populate only on the private staging/production host, never in GitHub.
# Lava.top: account API key + UUID of a published dynamic-price product.
TMS_SAAS_LAVA_TOP_API_KEY=
TMS_SAAS_LAVA_TOP_OFFER_ID=
# Separate CENTRAL platform-owned @CryptoBot Crypto Pay application.
TMS_SAAS_CRYPTO_PAY_API_TOKEN=
# Use true only with a @CryptoTestnetBot token and isolated test acceptance.
TMS_SAAS_CRYPTO_PAY_TESTNET=false
# Stars payout quote is saved by the platform owner in @vimipay_bot via
# /saasstarsrate <verified RUB earned per 1 Star>, NOT an environment key.

# Central bot only, enable after the separate payment redirect API and HTTPS route are verified.
TMS_SAAS_SHORTLINKS_ENABLED=false
